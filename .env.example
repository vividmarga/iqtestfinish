# ─────────────────────────────────────────────────────────────────────────────
# IQTest.ro — Environment Variables
# COPIAZĂ acest fișier ca `.env` și completează cu cheile tale REALE.
# NU comite NICIODATĂ fișierul `.env` pe GitHub (e inclus în .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── STRIPE ────────────────────────────────────────────────────────────────────
# Obții din: https://dashboard.stripe.com/apikeys
# Cheia PUBLISHABLE (publică, începe cu pk_live_ sau pk_test_)
# ATENȚIE: cheia SECRET (sk_...) NU se pune niciodată în frontend!
STRIPE_PUBLIC_KEY=pk_test_INLOCUIESTE_CU_CHEIA_TA

# ── EMAILJS ───────────────────────────────────────────────────────────────────
# Obții din: https://dashboard.emailjs.com → Account → API Keys
EMAILJS_SERVICE_ID=service_INLOCUIESTE
EMAILJS_TEMPLATE_ID=template_INLOCUIESTE
EMAILJS_PUBLIC_KEY=public_key_INLOCUIESTE
